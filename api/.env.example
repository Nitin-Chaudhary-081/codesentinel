# Environment variables for local development
# Copy to .env and fill in values

# Database (Supabase or local PostgreSQL)
# For Supabase: postgresql+asyncpg://postgres:[password]@db.[project].supabase.co:5432/postgres
# For local: postgresql+asyncpg://postgres:postgres@localhost:5432/codesentinel
DATABASE_URL=sqlite+aiosqlite:///./codesentinel_dev.db

# Redis (Upstash or local)
# For rediss://default:[password]@[host].upstash.io:6379
# For local: redis://localhost:6379
REDIS_URL=

# Auth
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# App
DEBUG=true
LOG_LEVEL=INFO
